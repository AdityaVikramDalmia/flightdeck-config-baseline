#!/usr/bin/env python3
"""Inventory explicitly selected files/directories and compare a versioned baseline."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import sys
import tempfile

VERSION = "0.1.0rc1"
MANIFEST_LIMIT = 16 * 1024 * 1024
LABEL = re.compile(r"[A-Za-z][A-Za-z0-9_-]{0,63}\Z")
NOFOLLOW = os.O_NOFOLLOW
DIRECTORY = os.O_DIRECTORY


class BaselineError(Exception):
    pass


def canonical_leaf(value):
    path = Path(value).absolute()
    if path.name in (".", ".."):
        path = path.resolve()
    if not path.name:
        raise BaselineError("select a bounded file or subdirectory, not a filesystem root")
    # Resolve only ancestors: a selected symlink is itself an inventory entry.
    return path.parent.resolve() / path.name


def entry_info(path):
    try:
        return path.lstat()
    except FileNotFoundError:
        return None


def same_inode(left, right):
    return (left.st_dev, left.st_ino) == (right.st_dev, right.st_ino)


def contains_entry(root, path):
    """Check lexical and existing filesystem identity without following root links."""
    if path == root or root in path.parents:
        return True
    root_info = entry_info(root)
    if root_info is None:
        return False
    path_info = entry_info(path)
    if path_info is not None and same_inode(root_info, path_info):
        return True
    if stat.S_ISDIR(root_info.st_mode):
        # realpath does not canonicalize letter case or Unicode normalization on
        # every filesystem. Compare ancestor inodes so aliases cannot bypass the
        # no-overlap/no-self-inclusion rules. A symlink root is only its link.
        for parent in path.parents:
            try:
                parent_info = parent.stat()
            except FileNotFoundError:
                continue
            if same_inode(root_info, parent_info):
                return True
    return False


def roots_from(values):
    roots = {}
    for value in values:
        name, sep, path = value.partition("=")
        if not sep or not LABEL.fullmatch(name) or not path:
            raise BaselineError("--root requires NAME=PATH; names use letters, digits, _ and -")
        if name in roots:
            raise BaselineError("duplicate root name: " + name)
        roots[name] = canonical_leaf(path)
    paths = list(roots.values())
    for index, left in enumerate(paths):
        for right in paths[index + 1:]:
            if contains_entry(left, right) or contains_entry(right, left):
                raise BaselineError("roots must not overlap or refer to the same path")
    return roots


def safe_manifest(path, roots):
    path = canonical_leaf(path)
    for root in roots.values():
        if contains_entry(root, path):
            raise BaselineError("manifest must be outside every selected root")
    if path.is_symlink():
        raise BaselineError("manifest must not be a symlink")
    if path.exists() and not path.is_file():
        raise BaselineError("manifest must be a regular file")
    return path


def signature(info):
    return (info.st_dev, info.st_ino, info.st_mode, info.st_size,
            info.st_mtime_ns, info.st_ctime_ns)


class Inventory:
    def __init__(self, max_entries, max_bytes, max_depth):
        self.max_entries = max_entries
        self.max_bytes = max_bytes
        self.max_depth = max_depth
        self.total_bytes = 0
        self.entries = []

    def scan(self, roots, allow_missing):
        for label, path in sorted(roots.items()):
            try:
                parent = os.open(str(path.parent), os.O_RDONLY | DIRECTORY | NOFOLLOW)
            except FileNotFoundError:
                if allow_missing:
                    continue
                raise BaselineError("selected root is missing: " + str(path))
            try:
                try:
                    os.stat(path.name, dir_fd=parent, follow_symlinks=False)
                except FileNotFoundError:
                    if allow_missing:
                        continue
                    raise BaselineError("selected root is missing: " + str(path))
                try:
                    self.visit(parent, path.name, label, "", 0)
                except FileNotFoundError as exc:
                    raise BaselineError("input disappeared during inventory: " + str(path)) from exc
            finally:
                os.close(parent)
        return sorted(self.entries, key=lambda entry: (entry["root"], entry["path"]))

    def visit(self, parent, name, label, relative, depth):
        before = os.stat(name, dir_fd=parent, follow_symlinks=False)
        if depth > self.max_depth:
            raise BaselineError("maximum depth exceeded at " + label + ":" + relative)
        if len(self.entries) >= self.max_entries:
            raise BaselineError("maximum entry count exceeded")
        entry = {"root": label, "path": relative, "mode": stat.S_IMODE(before.st_mode)}
        if stat.S_ISLNK(before.st_mode):
            entry.update(type="symlink", target=os.readlink(name, dir_fd=parent))
        elif stat.S_ISDIR(before.st_mode):
            entry["type"] = "directory"
            self.entries.append(entry)
            descriptor = os.open(name, os.O_RDONLY | DIRECTORY | NOFOLLOW, dir_fd=parent)
            try:
                if signature(os.fstat(descriptor)) != signature(before):
                    raise BaselineError("directory changed before reading: " + label + ":" + relative)
                names = []
                with os.scandir(descriptor) as listing:
                    for child in listing:
                        if len(names) + len(self.entries) >= self.max_entries:
                            raise BaselineError("maximum entry count exceeded")
                        names.append(child.name)
                for child in sorted(names):
                    child_path = relative + "/" + child if relative else child
                    try:
                        self.visit(descriptor, child, label, child_path, depth + 1)
                    except FileNotFoundError as exc:
                        raise BaselineError("input disappeared during inventory: " + label + ":" + child_path) from exc
                if signature(os.fstat(descriptor)) != signature(before):
                    raise BaselineError("directory changed during inventory: " + label + ":" + relative)
            finally:
                os.close(descriptor)
        elif stat.S_ISREG(before.st_mode):
            if self.total_bytes + before.st_size > self.max_bytes:
                raise BaselineError("maximum total file bytes exceeded")
            descriptor = os.open(name, os.O_RDONLY | NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
            try:
                opened = os.fstat(descriptor)
                if not stat.S_ISREG(opened.st_mode) or signature(opened) != signature(before):
                    raise BaselineError("file changed before reading: " + label + ":" + relative)
                hasher = hashlib.sha256()
                size = 0
                while True:
                    chunk = os.read(descriptor, min(1024 * 1024, self.max_bytes - self.total_bytes + 1))
                    if not chunk:
                        break
                    size += len(chunk)
                    self.total_bytes += len(chunk)
                    if self.total_bytes > self.max_bytes:
                        raise BaselineError("maximum total file bytes exceeded")
                    hasher.update(chunk)
                if size != before.st_size or signature(os.fstat(descriptor)) != signature(before):
                    raise BaselineError("file changed during reading: " + label + ":" + relative)
            finally:
                os.close(descriptor)
            entry.update(type="file", size=size, sha256=hasher.hexdigest())
        else:
            raise BaselineError("unsupported file type: " + label + ":" + relative)
        after = os.stat(name, dir_fd=parent, follow_symlinks=False)
        if signature(after) != signature(before):
            raise BaselineError("entry changed during inventory: " + label + ":" + relative)
        if entry["type"] != "directory":
            self.entries.append(entry)


def unique_object(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise BaselineError("duplicate JSON object key: " + key)
        value[key] = item
    return value


def validate(manifest, max_entries):
    if not isinstance(manifest, dict) or set(manifest) != {"version", "algorithm", "roots", "entries"}:
        raise BaselineError("invalid manifest envelope")
    if type(manifest["version"]) is not int or manifest["version"] != 1 or manifest["algorithm"] != "sha256":
        raise BaselineError("unsupported manifest version or algorithm")
    roots = manifest["roots"]
    if not isinstance(roots, list) or not roots or any(not isinstance(name, str) or not LABEL.fullmatch(name) for name in roots):
        raise BaselineError("invalid manifest roots")
    if len(set(roots)) != len(roots):
        raise BaselineError("duplicate manifest root")
    entries = manifest["entries"]
    if not isinstance(entries, list) or len(entries) > max_entries:
        raise BaselineError("invalid or oversized manifest entry list")
    indexed = {}
    for entry in entries:
        if not isinstance(entry, dict):
            raise BaselineError("invalid manifest entry")
        kind = entry.get("type")
        required = {"root", "path", "type", "mode"}
        if kind == "file":
            required |= {"sha256", "size"}
            if not isinstance(entry.get("sha256"), str) or not re.fullmatch("[a-f0-9]{64}", entry["sha256"]):
                raise BaselineError("invalid file digest")
            if type(entry.get("size")) is not int or entry["size"] < 0:
                raise BaselineError("invalid file size")
        elif kind == "symlink":
            required.add("target")
            if not isinstance(entry.get("target"), str) or not entry["target"] or "\0" in entry["target"]:
                raise BaselineError("invalid symlink target")
        elif kind != "directory":
            raise BaselineError("invalid entry type")
        if set(entry) != required or type(entry.get("mode")) is not int or not 0 <= entry["mode"] <= 0o7777:
            raise BaselineError("invalid entry fields or permissions")
        label, path = entry.get("root"), entry.get("path")
        if not isinstance(label, str) or label not in roots or not isinstance(path, str) or "\0" in path:
            raise BaselineError("invalid entry root or path")
        if path and (path.startswith("/") or any(part in ("", ".", "..") for part in path.split("/"))):
            raise BaselineError("entry path must stay relative to its root")
        key = (label, path)
        if key in indexed:
            raise BaselineError("duplicate manifest entry")
        indexed[key] = entry
    for root in roots:
        if (root, "") not in indexed:
            raise BaselineError("manifest omits a root entry")
    for (label, path), entry in indexed.items():
        if path:
            parent = indexed.get((label, path.rpartition("/")[0]))
            if parent is None or parent["type"] != "directory":
                raise BaselineError("manifest entry has no directory parent")
    return manifest


def load_manifest(path, max_entries):
    descriptor = os.open(str(path), os.O_RDONLY | NOFOLLOW | os.O_NONBLOCK)
    try:
        before = os.fstat(descriptor)
        if not stat.S_ISREG(before.st_mode) or before.st_size > MANIFEST_LIMIT:
            raise BaselineError("manifest is not a regular file within the 16 MiB limit")
        data = bytearray()
        while True:
            chunk = os.read(descriptor, min(1024 * 1024, MANIFEST_LIMIT - len(data) + 1))
            if not chunk:
                break
            data.extend(chunk)
            if len(data) > MANIFEST_LIMIT:
                raise BaselineError("manifest exceeds 16 MiB")
        if signature(before) != signature(os.fstat(descriptor)):
            raise BaselineError("manifest changed during reading")
    finally:
        os.close(descriptor)
    def invalid_constant(value):
        raise BaselineError("invalid JSON numeric constant: " + value)
    manifest = json.loads(data, object_pairs_hook=unique_object, parse_constant=invalid_constant)
    return validate(manifest, max_entries)


def publish(path, manifest, overwrite):
    data = (json.dumps(manifest, sort_keys=True, indent=2, ensure_ascii=True) + "\n").encode("utf-8")
    if len(data) > MANIFEST_LIMIT:
        raise BaselineError("manifest exceeds 16 MiB")
    descriptor, temporary = tempfile.mkstemp(prefix=".config-baseline-", suffix=".tmp", dir=str(path.parent))
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        if overwrite:
            os.replace(temporary, path)
        else:
            os.link(temporary, path)
        directory = os.open(str(path.parent), os.O_RDONLY | DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def compare(baseline, current):
    old = {(entry["root"], entry["path"]): entry for entry in baseline}
    new = {(entry["root"], entry["path"]): entry for entry in current}
    findings = []
    summary = {"added": 0, "removed": 0, "changed": 0}
    for key in sorted(old.keys() | new.keys()):
        before, after = old.get(key), new.get(key)
        if before == after:
            continue
        state = "added" if before is None else "removed" if after is None else "changed"
        fields = sorted(name for name in before.keys() | after.keys() if before.get(name) != after.get(name)) if before and after else []
        findings.append({"root": key[0], "path": key[1], "state": state, "fields": fields,
                         "before": before, "after": after})
        summary[state] += 1
    return {"status": "changed" if findings else "unchanged", "summary": summary, "findings": findings}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--version", action="version", version="config-baseline " + VERSION)
    sub = parser.add_subparsers(dest="command", required=True)
    for name in ("snapshot", "check"):
        command = sub.add_parser(name)
        command.add_argument("--manifest", required=True, type=Path)
        command.add_argument("--root", action="append", required=True, metavar="NAME=PATH")
        command.add_argument("--json", action="store_true")
        command.add_argument("--max-entries", type=int, default=10000)
        command.add_argument("--max-bytes", type=int, default=100 * 1024 * 1024)
        command.add_argument("--max-depth", type=int, default=32)
        if name == "snapshot":
            command.add_argument("--overwrite", action="store_true", help="explicitly replace an existing manifest")
    args = parser.parse_args()
    try:
        if args.max_entries <= 0 or args.max_bytes < 0 or not 0 <= args.max_depth <= 256:
            raise BaselineError("limits require positive entries, nonnegative bytes, and depth from 0 to 256")
        roots = roots_from(args.root)
        manifest_path = safe_manifest(args.manifest, roots)
        if args.command == "check":
            baseline = load_manifest(manifest_path, args.max_entries)
            if set(baseline["roots"]) != set(roots):
                raise BaselineError("explicit root names must exactly match the manifest")
        elif os.path.lexists(manifest_path) and not args.overwrite:
            raise BaselineError("manifest already exists; use --overwrite only to replace the reference intentionally")
        entries = Inventory(args.max_entries, args.max_bytes, args.max_depth).scan(roots, args.command == "check")
        if args.command == "snapshot":
            manifest = {"version": 1, "algorithm": "sha256", "roots": sorted(roots), "entries": entries}
            validate(manifest, args.max_entries)
            publish(manifest_path, manifest, args.overwrite)
            result = {"status": "written", "manifest": str(manifest_path), "entries": len(entries), "roots": sorted(roots)}
            code = 0
        else:
            result = compare(baseline["entries"], entries)
            result["manifest"] = str(manifest_path)
            code = 3 if result["findings"] else 0
    except (BaselineError, OSError, ValueError, RuntimeError) as exc:
        result = {"status": "error", "error": str(exc)}
        code = 2
    if args.json:
        print(json.dumps(result, sort_keys=True))
    elif code == 2:
        print("ERROR: " + result["error"], file=sys.stderr)
    elif args.command == "snapshot":
        print("Written " + str(result["entries"]) + " entries: " + json.dumps(result["manifest"]))
    else:
        print(result["status"].upper() + ": " + ", ".join(str(value) + " " + key for key, value in result["summary"].items()))
        for finding in result["findings"]:
            print(finding["state"].upper() + " " + finding["root"] + ":" + json.dumps(finding["path"]) +
                  (" (" + ", ".join(finding["fields"]) + ")" if finding["fields"] else ""))
    return code


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        sys.exit(2)
